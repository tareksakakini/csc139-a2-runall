{
  "name": "CSC 139 - Operating System Principles",
  "build": { "dockerfile": "Dockerfile" },

  // SYS_PTRACE + unconfined seccomp let strace/ltrace/gdb trace your own
  // processes inside the container. Modern Docker already permits ptrace by
  // default, but this makes it explicit and portable across hosts.
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt", "seccomp=unconfined"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.default.cStandard": "c17",
        "files.eol": "\n"
      }
    }
  },

  "postCreateCommand": "make check-env",
  "remoteUser": "vscode"
}
